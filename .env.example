# Family CFO - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/familycfo
DB_HOST=localhost
DB_PORT=5433
DB_NAME=familycfo
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Secret key for JWT token generation (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# JWT Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development, staging, production
ENVIRONMENT=development

# API Base URL
API_BASE_URL=http://localhost:8000

# Frontend URLs (for CORS)
ADMIN_FRONTEND_URL=http://localhost:3000
MOBILE_FRONTEND_URL=http://localhost:3006

# =============================================================================
# AI / LLM CONFIGURATION
# =============================================================================

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# --- OpenRouter Configuration ---
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Family CFO

# Which AI provider to use: openai, openrouter
AI_PROVIDER=openrouter

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Your Telegram user ID (get from @userinfobot)
TELEGRAM_ADMIN_USER_ID=your-telegram-user-id
# Telegram webhook URL (for production)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Enable/disable Telegram notifications
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Notification settings
TELEGRAM_NOTIFY_NEW_TRANSACTIONS=true
TELEGRAM_NOTIFY_LARGE_EXPENSES=true
TELEGRAM_LARGE_EXPENSE_THRESHOLD=500.00
TELEGRAM_NOTIFY_SUBSCRIPTION_RENEWALS=true
TELEGRAM_RENEWAL_NOTICE_DAYS=7

# =============================================================================
# EMAIL / SMTP CONFIGURATION
# =============================================================================
# SMTP Server settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMTP Authentication
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Email sender information
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Family CFO

# Email notification settings
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFY_WEEKLY_SUMMARY=true
EMAIL_NOTIFY_MONTHLY_REPORT=true
EMAIL_NOTIFY_BUDGET_ALERTS=true

# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@example.com

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# --- Plaid (Banking Integration) ---
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
# Options: sandbox, development, production

# --- Stripe (Payment Processing) ---
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Twilio (SMS Notifications) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# FILE STORAGE
# =============================================================================
# Storage provider: local, s3, azure
STORAGE_PROVIDER=local

# Local storage path
LOCAL_STORAGE_PATH=./uploads

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=familycfo-uploads
AWS_S3_REGION=us-east-1

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_STORAGE_CONTAINER=familycfo-uploads

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# =============================================================================
# SECURITY
# =============================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3006

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Session settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_CATEGORIZATION=true
FEATURE_TELEGRAM_BOT=true
FEATURE_EMAIL_REPORTS=true
FEATURE_PLAID_INTEGRATION=false
FEATURE_OCR_RECEIPTS=false
FEATURE_MULTI_CURRENCY=false

# =============================================================================
# CRON JOBS / SCHEDULED TASKS
# =============================================================================
# Enable background jobs
ENABLE_SCHEDULED_TASKS=true

# Daily summary time (24-hour format)
DAILY_SUMMARY_TIME=09:00

# Weekly report day (0=Sunday, 6=Saturday)
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_TIME=10:00

# Monthly report day (1-28)
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_TIME=09:00

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================
# Enable debug mode
DEBUG=true

# Enable SQL query logging
SQL_ECHO=false

# Enable API documentation
ENABLE_DOCS=true
ENABLE_REDOC=true

# Hot reload
HOT_RELOAD=true
